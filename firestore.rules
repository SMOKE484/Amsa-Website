rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Applications: Users can manage their own, admins can manage all
    match /applications/{userId} {
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !exists(/databases/$(database)/documents/applications/$(userId));

      allow read, update, delete: if
        // User accessing their own application
        (request.auth != null && request.auth.uid == userId) ||
        // Admin accessing any application
        (request.auth != null && isAdminUser());
    }

    // Users: manage their own profile data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Admins: can read the admin collection (for role verification)
    match /admins/{adminId} {
      allow read: if request.auth != null &&
        (request.auth.uid == adminId || isAdminUser());
      allow write: if false; // only through admin SDK or Firebase console
    }

    // Trips: public read of active trips (for the sign-up form's trip
    // picker), admin-only write. Trip metadata has no PII, so a public read
    // is fine even though the site has no login for this form.
    match /trips/{tripId} {
      allow read: if resource.data.active == true || (request.auth != null && isAdminUser());
      allow write: if request.auth != null && isAdminUser();
    }
    // Trip submissions contain contact + emergency + medical info collected
    // from an unauthenticated public form. The only writer is the
    // submitTripForm Cloud Function via the Admin SDK, which bypasses these
    // rules entirely -- so this collection is deliberately read-only-for-
    // admins / write-never-from-a-client.
    match /tripSubmissions/{submissionId} {
      allow read: if request.auth != null && isAdminUser();
      allow write: if false;
    }

    // Idempotency lock markers and error logs for the trip flow are
    // server-only (Admin SDK), same as payment_verifications/payment_errors.
    match /trip_submission_locks/{lockId} {
      allow read, write: if false;
    }
    match /trip_errors/{errorId} {
      allow read, write: if false;
    }

    // Helper function to check if user is admin
    function isAdminUser() {
      return request.auth != null &&
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         request.auth.token.email == 'vhulendamashamba4@gmail.com' ||
         request.auth.token.email.matches('.*@alusaniacademy\\.edu\\.za'));
    }

    // Default deny - remove or modify as needed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
